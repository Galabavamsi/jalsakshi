# Copy to .env (gitignored) and fill in locally. Deployed stages read these from SSM /jalsakshi/<stage>/...
STAGE=dev-yourname
AWS_PROFILE=aws-main
JALSAKSHI_REGION=ap-south-1

# Voice
SARVAM_API_KEY=
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_DID=+91XXXXXXXXXX
BOLNA_API_KEY=

# Comma-separated E.164 numbers of people who consented to test calls (team only)
TEST_NUMBERS=+91XXXXXXXXXX,+91XXXXXXXXXX
