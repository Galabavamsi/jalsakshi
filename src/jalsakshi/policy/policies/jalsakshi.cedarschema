// Entity and request shapes for jalsakshi.cedar. Requests that do not match are rejected,
// and the engine then fails closed (deny).

// The JalSakshi backend itself (scheduler, Step Functions, Lambda handlers).
entity System;

// A console user. role is an OperatorRole value from core/models.py.
entity Operator = {
  role: String,
};

entity Household = {
  village_id: String,
  consent_given: Bool,
  consent_status: String,
};

entity Village;

entity Ticket = {
  village_id: String,
  quorum: Long,
};

action PlaceCall appliesTo {
  principal: [System, Operator],
  resource: [Household],
  context: {
    hour_ist: Long,
    calls_today: Long,
    purpose: String,
    caller_initiated: Bool,
    callbacks_today: Long,
    test_phone: Bool,
  },
};

action CloseVerified appliesTo {
  principal: [System, Operator],
  resource: [Ticket],
  context: {
    verify_yes: Long,
  },
};

action ViewHouseholdAnswers appliesTo {
  principal: [Operator],
  resource: [Village],
};

// data_age_hours is whole hours rounded up, so "> 24" is exact for fractional ages.
action PublishEvidence appliesTo {
  principal: [System, Operator],
  resource: [Village],
  context: {
    data_age_hours: Long,
  },
};

entity Broadcast = {
  village_id: String,
  state: String,
};

action ApproveBroadcast appliesTo {
  principal: [Operator],
  resource: [Broadcast],
};

action SendBroadcast appliesTo {
  principal: [System, Operator],
  resource: [Broadcast],
  context: {
    sent_last_7_days: Long,
  },
};
