# Copy to .env.local (gitignored) for local development. All values are build-time (Vite).
# mock = seeded demo data, no network, no sign-in. Anything else = real API + Cognito.
VITE_API_MODE=mock

# Real API (API Gateway HTTP API in ap-south-1), no trailing slash
VITE_API_BASE=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com

# Cognito Hosted UI (OAuth2 authorization code + PKCE)
VITE_COGNITO_DOMAIN=https://jalsakshi-dev-yourname.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
# Optional: where Cognito sends the browser after sign-out (default: origin of VITE_REDIRECT_URI)
VITE_LOGOUT_URI=http://localhost:5173/
# Optional: OAuth scopes (default: openid email profile)
VITE_COGNITO_SCOPES=openid email profile
